{
  "manifest_version": 3,
  "name": "LF Tools",
  "version": "1.19.0",
  "description": "LF Tools",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}